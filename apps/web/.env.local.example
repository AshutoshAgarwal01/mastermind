# Copy this file to .env.local (git-ignored) to test Application Insights locally.
# Vite loads .env.local automatically — no restart-only-once caveat, but you do need to
# restart `npm run dev:web` after adding/changing this file.
# See ../../docs/telemetry.md and ../../docs/local-development.md.
VITE_APPINSIGHTS_CONNECTION_STRING=
